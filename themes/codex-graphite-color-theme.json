    "inputValidation.errorBackground": "#3a1f22",
    "inputValidation.errorBorder": "#f27d84",
    "inputValidation.warningBackground": "#3a2f1a",
    "inputValidation.warningBorder": "#e0b05a",
    "inputValidation.infoBackground": "#1c2f3f",
    "inputValidation.infoBorder": "#79b8f5",
    "dropdown.background": "#26231f",
    "dropdown.foreground": "#c5c8cd",
    "dropdown.border": "#363533",
    "button.background": "#e0a458",
    "button.foreground": "#0f1011",
    "button.hoverBackground": "#e5b271",
    "button.secondaryBackground": "#312f2c",
    "button.secondaryForeground": "#e4e6ea",
    "button.secondaryHoverBackground": "#3b3a38",
    "badge.background": "#e0a458",
    "badge.foreground": "#0f1011",
    "progressBar.background": "#e0a458",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#ffffff14",
    "scrollbarSlider.hoverBackground": "#ffffff26",
    "scrollbarSlider.activeBackground": "#ffffff33",
    "editorWidget.background": "#26231f",
    "editorWidget.border": "#3b3a38",
    "editorSuggestWidget.background": "#26231f",
    "editorSuggestWidget.border": "#3b3a38",
    "editorSuggestWidget.selectedBackground": "#e0a45826",
    "editorSuggestWidget.highlightForeground": "#e2ab65",
    "editorHoverWidget.background": "#26231f",
    "editorHoverWidget.border": "#3b3a38",
    "peekView.border": "#e0a458",
    "peekViewEditor.background": "#1c1914",
    "peekViewResult.background": "#221f1b",
    "peekViewTitle.background": "#221f1b",
    "peekViewResult.selectionBackground": "#e0a45826",
    "peekViewEditor.matchHighlightBackground": "#e0b05a44",
    "notifications.background": "#26231f",
    "notifications.border": "#3b3a38",
    "notificationCenterHeader.background": "#1e1b16",
    "quickInput.background": "#26231f",
    "quickInputList.focusBackground": "#e0a45826",
    "pickerGroup.foreground": "#e2ab65",
    "pickerGroup.border": "#312f2c",
    "diffEditor.insertedTextBackground": "#7fbf6a1f",
    "diffEditor.removedTextBackground": "#e06c752a",
    "diffEditor.insertedLineBackground": "#7fbf6a14",
    "diffEditor.removedLineBackground": "#e06c7517",
    "gitDecoration.addedResourceForeground": "#8cc87a",
    "gitDecoration.modifiedResourceForeground": "#6fb3ea",
    "gitDecoration.deletedResourceForeground": "#e06c75",
    "gitDecoration.untrackedResourceForeground": "#79c9a0",
    "gitDecoration.ignoredResourceForeground": "#555a61",
    "gitDecoration.conflictingResourceForeground": "#e0b05a",
    "gitDecoration.stageModifiedResourceForeground": "#6fb3ea",
    "gitDecoration.stageDeletedResourceForeground": "#e06c75",
    "terminal.background": "#1c1914",
    "terminal.foreground": "#c5c8cd",
    "terminal.selectionBackground": "#e0a45833",
    "terminalCursor.foreground": "#e0a458",
    "terminal.ansiBlack": "#221f1b",
    "terminal.ansiRed": "#e06c75",
    "terminal.ansiGreen": "#8cc87a",
    "terminal.ansiYellow": "#e0b05a",
    "terminal.ansiBlue": "#6fb3ea",
    "terminal.ansiMagenta": "#c39af5",
    "terminal.ansiCyan": "#e2ab65",
    "terminal.ansiWhite": "#c5c8cd",
    "terminal.ansiBrightBlack": "#5a5f66",
    "terminal.ansiBrightRed": "#f27d84",
    "terminal.ansiBrightGreen": "#a3d98f",
    "terminal.ansiBrightYellow": "#ecc374",
    "terminal.ansiBrightBlue": "#8cc4f2",
    "terminal.ansiBrightMagenta": "#d2b3f8",
    "terminal.ansiBrightCyan": "#ecc89b",
    "terminal.ansiBrightWhite": "#f0f2f5",
    "debugToolBar.background": "#26231f",
    "debugIcon.breakpointForeground": "#e06c75",
    "settings.headerForeground": "#e4e6ea",
    "settings.modifiedItemIndicator": "#e0a458",
    "keybindingLabel.background": "#ffffff10",
    "keybindingLabel.foreground": "#c5c8cd",
    "keybindingLabel.border": "#3b3a38",
    "keybindingLabel.bottomBorder": "#00000066"
  },
  "semanticTokenColors": {
    "namespace": "#e0b05a",
    "class": "#e0b05a",
    "interface": "#e0b05a",
    "enum": "#e0b05a",
    "enumMember": "#d99a6c",
    "struct": "#e0b05a",
    "typeParameter": "#e0b05a",
    "type": "#e0b05a",
    "function": "#79b8f5",
    "method": "#79b8f5",
    "decorator": "#c39af5",
    "macro": "#c39af5",
    "parameter": {
      "foreground": "#e6a98f",
      "italic": true
    },
    "property": "#d0d3d8",
    "variable.readonly": "#d99a6c",
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a0a6ad",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#c39af5"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#5ec4d4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9ccc7e"
      }
    },
    {
      "name": "String escapes & regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5ec4d4"
      }
    },
    {
      "name": "Numbers & constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e6a98f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#79b8f5"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e0b05a"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#d0d3d8"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e6a98f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#f08d7a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c5c8cd"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#b5bac1"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#f08d7a"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e0b05a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS properties & values",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#79b8f5"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#e0b05a"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#79b8f5"
      }
    },
    {
      "name": "Decorators / annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#c39af5"
      }
    },
    {
      "name": "Imports / modules",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#c39af5"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#79b8f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c39af5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6a98f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code & links",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9ccc7e"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5ec4d4"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8cc87a"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#6fb3ea"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f27d84"
      }
    }
  ]
}
