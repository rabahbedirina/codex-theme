    "titleBar.activeBackground": "#1a1712",
    "titleBar.activeForeground": "#c5c8cd",
    "titleBar.inactiveBackground": "#1a1712",
    "titleBar.inactiveForeground": "#666b73",
    "titleBar.border": "#312f2c",
    "menubar.selectionBackground": "#ffffff14",
    "menu.background": "#26231f",
    "menu.foreground": "#c5c8cd",
    "menu.selectionBackground": "#e0a45826",
    "menu.selectionForeground": "#ffffff",
    "menu.separatorBackground": "#312f2c",
