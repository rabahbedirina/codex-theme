    "list.errorForeground": "#f27d84",
    "list.warningForeground": "#e0b05a",
    "tree.indentGuidesStroke": "#3b3a38",
    "statusBar.background": "#1a1712",
    "statusBar.foreground": "#9aa0a8",
    "statusBar.border": "#312f2c",
    "statusBar.noFolderBackground": "#1a1712",
    "statusBar.debuggingBackground": "#7a4a1f",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#ffffff14",
    "statusBarItem.remoteBackground": "#e0a458",
